<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- YouTube-style high-contrast pill (dark on light theme, light on dark theme) -->
    <style name="ServiceColoredButton" parent="Widget.AppCompat.Button.Colored">
        <item name="colorButtonNormal">@color/subscribe_background_color</item>
        <item name="android:textColor">@color/subscribe_text_color</item>
        <item name="android:textAllCaps">false</item>
        <item name="colorControlHighlight">@color/yt_chip_pressed</item>
    </style>


    <!--File picker styles-->
    <style name="FilePickerThemeLight" parent="NNF_BaseTheme.Light">
        <item name="colorPrimary">@color/yt_light_surface</item>
        <item name="colorPrimaryDark">@color/yt_light_surface</item>
        <item name="colorAccent">@color/light_settings_accent_color</item>

        <item name="actionColor">@color/white</item>
        <item name="nnf_toolbarTheme">@style/ToolbarTheme</item>

        <item name="android:windowBackground">@color/light_background_color</item>
        <item name="nnf_separator_color">@color/light_separator_color</item>

        <item name="alertDialogTheme">@style/FilePickerAlertDialogThemeLight</item>
    </style>

    <style name="FilePickerThemeDark" parent="NNF_BaseTheme">
        <item name="colorPrimary">@color/yt_dark_surface</item>
        <item name="colorPrimaryDark">@color/yt_dark_surface</item>
        <item name="colorAccent">@color/dark_settings_accent_color</item>

        <item name="actionColor">@color/white</item>
        <item name="nnf_toolbarTheme">@style/ToolbarTheme</item>

        <item name="android:windowBackground">@color/dark_background_color</item>
        <item name="nnf_separator_color">@color/black_separator_color</item>

        <item name="alertDialogTheme">@style/FilePickerAlertDialogThemeDark</item>
    </style>

    <style name="FilePickerAlertDialogThemeLight" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/yt_light_surface</item>
        <item name="colorPrimaryDark">@color/yt_light_surface</item>
        <item name="colorAccent">@color/light_settings_accent_color</item>
    </style>

    <style name="FilePickerAlertDialogThemeDark" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/yt_dark_surface</item>
        <item name="colorPrimaryDark">@color/yt_dark_surface</item>
        <item name="colorAccent">@color/dark_settings_accent_color</item>
    </style>

    <style name="PlayQueueItemTextTheme">
        <item name="android:textAppearanceLarge">@style/PlayQueueItemTitle</item>
        <item name="android:textAppearanceSmall">@style/PlayQueueItemSubtitle</item>
    </style>

    <style name="PlayQueueItemTitle" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="PlayQueueItemSubtitle" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">@color/white_secondary</item>
    </style>

    <style name="FloatingActionButtonTheme" parent="Widget.Design.FloatingActionButton">
        <item name="tint">@color/subscribe_text_color</item>
        <item name="backgroundTint">@color/subscribe_background_color</item>
    </style>

    <style name="DarkPopupMenu" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- Toolbars sit on the plain surface color (YouTube style), so tint with the
         theme's contrast color instead of always-white -->
    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.DayNight.ActionBar</item>
        <item name="android:textColorPrimary">@color/yt_on_surface</item>
        <item name="android:textColorSecondary">@color/yt_secondary_text</item>
        <item name="colorControlNormal">@color/yt_on_surface</item>
        <!-- no theme-wide "tint": it would also tint the colored logo -->
        <item name="iconTint">@color/yt_on_surface</item>
        <item name="toolbarSearchColor">@color/yt_on_surface</item>
    </style>
    <style name="ContrastToolbarTheme" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.DayNight.ActionBar</item>
        <item name="android:textColorPrimary">@color/contrastColor</item>
        <item name="android:textColorSecondary">@color/contrastColor</item>
        <item name="tint">@color/contrastColor</item>
        <item name="iconTint">@color/contrastColor</item>
        <item name="toolbarSearchColor">@color/contrastColor</item>
    </style>

    <style name="WhiteTintTheme">
        <item name="tint">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="ContrastTintTheme">
        <item name="tint">@color/contrastColor</item>
        <item name="iconTint">@color/contrastColor</item>
    </style>

    <style name="ToolbarSearchInputTheme">
        <item name="colorPrimary">?attr/toolbarSearchColor</item>
        <item name="colorPrimaryDark">?attr/toolbarSearchColor</item>
        <item name="colorAccent">?attr/toolbarSearchColor</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedThumbnailImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- YouTube-style UI -->
    <style name="YtToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Rounded action button in the horizontal row under a video (Share, Download, ...) -->
    <style name="YtActionPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/yt_pill_background</item>
        <item name="android:foreground">?attr/focused_selector</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/yt_on_surface</item>
        <item name="android:maxLines">1</item>
        <item name="drawableTint">@color/yt_on_surface</item>
    </style>

    <!-- Icon-over-label action on the right side of a Short -->
    <style name="YtShortsAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="drawableTint">@android:color/white</item>
    </style>

</resources>
