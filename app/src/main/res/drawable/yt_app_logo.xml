<?xml version="1.0" encoding="utf-8"?>
<!-- Small logo for the main top bar: PipePipe's own TV glyph on a red rounded tile -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="30dp"
        android:height="21dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/yt_red" />
        </shape>
    </item>
    <item
        android:width="15dp"
        android:height="15dp"
        android:drawable="@drawable/ic_pipepipe"
        android:gravity="center" />
</layer-list>
