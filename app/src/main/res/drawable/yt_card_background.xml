<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded grey card, e.g. the comments teaser under a video -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/yt_chip_pressed">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/yt_chip_background" />
        </shape>
    </item>
</ripple>
